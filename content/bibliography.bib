@ARTICLE{Yigit_etal21b,
author = {E. Yi\u{g}it and A. S. Medvedev and M. Benna and B. Jakosky},
title = {Dust storm-enhanced gravity wave activity in the {M}artian thermosphere observed by {MAVEN} and implication for atmospheric escape},
journal = {Geophysical Review Letters},
volume = {n/a},
number = {n/a},
pages = {e2020GL092095},
keywords = {Atmospheric gravity waves, Mars, MAVEN, Atmospheric escape, Thermosphere, Dust
                  storms},
doi = {https://doi.org/10.1029/2020GL092095},
abstract = {Abstract Lower atmospheric global dust storms affect the small- and large-scale weather and variability of the whole Martian atmosphere. Analysis of the CO2 density data from the Neutral Gas and Ion Mass Spectrometer instrument (NGIMS) on board NASA's Mars Atmosphere Volatile EvolutioN (MAVEN) spacecraft show a remarkable increase of GW-induced density fluctuations in the thermosphere during the 2018 major dust storm with distinct latitude and local time variability. The mean thermospheric GW activity increases by a factor of two during the storm event. The magnitude of relative density perturbations is around 20\% on average and 40\% locally. One and a half months later, the GW activity gradually decreases. Enhanced temperature disturbances in the Martian thermosphere can facilitate atmospheric escape. For the first time, we estimate that, for a 20\% and 40\% GW-induced disturbances, the net increase of Jeans escape flux of hydrogen is a factor of 1.3 and 2, respectively.},
YEAR = {2021}}

@article {Jakosky2001,
	Title = {Mars' volatile and climate history},
	Author = {Jakosky, BM and Phillips, RJ},
	DOI = {10.1038/35084184},
	Number = {6843},
	Volume = {412},
	Month = {July},
	Year = {2001},
	Journal = {Nature},
	ISSN = {0028-0836},
	Pages = {237—244},
	Abstract = {There is substantial evidence that the martian volatile inventory and climate have changed markedly throughout the planet's history. Clues come from areas as disparate as the history and properties of the deep interior, the composition of the crust and regolith, the morphology of the surface, composition of the present-day atmosphere, and the nature of the interactions between the upper atmosphere and the solar wind. We piece together the relevant observations into a coherent view of the evolution of the martian climate, focusing in particular on the observations that provide the strongest constraints.},
	URL = {http://www.lpi.usra.edu/meetings/lpsc2000/pdf/2033.pdf},
}

