@article{Berger1999,
author = {Berger, U. and von Zahn, U.},
title = {The two-level structure of the mesopause: A model study},
journal = {Journal of Geophysical Research: Atmospheres},
volume = {104},
number = {D18},
pages = {22083-22093},
doi = {https://doi.org/10.1029/1999JD900389},
url = {https://agupubs.onlinelibrary.wiley.com/doi/abs/10.1029/1999JD900389},
eprint = {https://agupubs.onlinelibrary.wiley.com/doi/pdf/10.1029/1999JD900389},
abstract = {Recent global-scale observations of the mesopause thermal structure show the altitude of the mesopause to be located regularly near 100 km and in a small minority of cases near 88 km. In this paper we use a three-dimensional nonlinear model of the middle-upper atmosphere (0-150 km) to explore the processes which lead to this two-level structure of the mesopause. More specifically, we evaluate by way of sensitivity studies the influences of (1) photochemical heating processes, (2) gravity wave momentum deposition, and (3) vibrational excitation of CO2 molecules by collisions with O atoms on the global mesopause structure. We also calculate the effects which solar-induced tides have locally on the diurnal variations of the mesopause altitude. The results of our numerical simulations suggest (1) that indeed two distinct mesopause levels exist worldwide even in terms of zonal mean states, (2) that the two-level feature is mostly due to the photochemical heating processes in combination with gravity wave momentum deposition, and (3) that the two-level mesopause structure is not a local phenomenon of tidal wave activity.},
year = {1999}
}

